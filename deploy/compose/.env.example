# Copy to .env (git-ignored) next to compose.yaml and set real values on the shared server.
# Every value has a development default in compose.yaml, so a laptop needs no .env.

# The host port for the Envoy edge. The default is 8080; set 18080 if 8080 is reserved
# on Windows (Hyper-V excluded ranges) or already in use.
GATEWAY_PORT=8080

POSTGRES_USER=taakht
POSTGRES_PASSWORD=change-me
AD_DB_PASSWORD=change-me
MATCHING_DB_PASSWORD=change-me
DEAL_DB_PASSWORD=change-me
REPUTATION_DB_PASSWORD=change-me
COMMUNICATION_DB_PASSWORD=change-me
